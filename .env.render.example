# Render backend environment variables
# Keep real secrets in Render dashboard only.

# Neon PostgreSQL JDBC URL used by Spring Boot profile neon
NEON_JDBC_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channelBinding=require

# Neon credentials
NEON_DB_USERNAME=YOUR_NEON_USERNAME
NEON_DB_PASSWORD=YOUR_NEON_PASSWORD

# Render injects PORT automatically; do not set it manually unless needed.

# Allow your frontend origin(s), comma-separated if multiple
APP_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.onrender.com

# JWT signing secret (REQUIRED, >= 32 bytes). The app refuses to start without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional: token lifetime in milliseconds (default 86400000 = 24h)
# JWT_EXPIRATION_MS=86400000

# Admin bootstrap (AdminBootstrap runs at startup, after Flyway migrations).
# When BOTH are set, the ADMIN account with this email is created, or its
# password is reset (bcrypt), and the account is enabled with role ADMIN.
# The password is never logged. Minimum 12 characters.
# Migration V5 invalidated the publicly known seed password of the seeded
# admin, so set these on the first deploy of V5, log in, then remove them
# (otherwise the password is reset again on every restart).
ADMIN_BOOTSTRAP_EMAIL=admin@YOUR_DOMAIN
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
