# Render backend environment variables
# Keep real secrets in Render dashboard only.

# Neon PostgreSQL JDBC URL used by Spring Boot profile neon
NEON_JDBC_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channelBinding=require

# Neon credentials
NEON_DB_USERNAME=YOUR_NEON_USERNAME
NEON_DB_PASSWORD=YOUR_NEON_PASSWORD

# Render injects PORT automatically; do not set it manually unless needed.

# Allow your frontend origin(s), comma-separated if multiple
APP_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.onrender.com
